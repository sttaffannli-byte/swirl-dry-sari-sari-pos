{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swirl-dry-sari-sari-pos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swirl-dry-sari-sari-pos-db",
      "database_id": "626287a1-24d6-460c-a4e9-a64d287926df",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
